{"version":3,"kind":"Article","sha256":"d6e465711f95415b6224bf32d7c5a77df3b935fab07d0b39c594723f83f29695","slug":"data-access","location":"/content/code_gallery/data_access.md","dependencies":[],"frontmatter":{"title":"Data Access","content_includes_title":false,"github":"https://github.com/ioos/ioos_code_lab","numbering":{"title":{"offset":1}},"source_url":"https://github.com/ioos/ioos_code_lab/blob/main/jupyterbook/content/code_gallery/data_access.md","edit_url":"https://github.com/ioos/ioos_code_lab/edit/main/jupyterbook/content/code_gallery/data_access.md","exports":[{"format":"md","filename":"data_access.md","url":"/ioos_code_lab/build/data_access-d08ba7b968641e61bce29d3d90c8804b.md"}]},"mdast":{"type":"root","children":[{"type":"block","children":[{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":6,"column":1}},"children":[{"type":"text","value":"IOOS data comes from a variety of technologies or data collection systems. While types of data available through any\none of our 11 regional associations may vary depending on the local area, the national IOOS data products include data\ncollected from buoys, high frequency radar systems and gliders. Modeling teams across regional associations also create\ndata products including physical and environmental models of coastal systems.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"cPjPB36Gev"}],"key":"PZrMShXBw1"},{"type":"paragraph","position":{"start":{"line":8,"column":1},"end":{"line":11,"column":1}},"children":[{"type":"text","value":"IOOS data can be accessed through a variety of access services and tools through IOOS interactive maps, Data Assembly\nCenters (DACs), and individual Regional Association portals. This chapter provides examples of the various data access\nservices (SOS, THREDDS, ERDDAP, etc) and tools for scientists and managers looking to access data using various programing languages (Python,\nMatlab, R, etc).","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"key":"E9N2Tw3m6P"}],"key":"ylgeLqyWnb"},{"type":"paragraph","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"children":[{"type":"text","value":"For more information on accessing IOOS data, see ","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"key":"QwZ2H5Kr36"},{"type":"link","url":"https://ioos.noaa.gov/data/access-ioos-data/","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"children":[{"type":"text","value":"https://​ioos​.noaa​.gov​/data​/access​-ioos​-data/","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"key":"Pwtl80L0s5"}],"urlSource":"https://ioos.noaa.gov/data/access-ioos-data/","key":"AvCPybQjX3"},{"type":"text","value":".","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"key":"L3QVC2MkHC"}],"key":"MwDsdfzDkk"}],"key":"kQd70g4tlT"}],"key":"RiWOtJazOT"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Gallery","url":"/gallery","group":"Code Gallery"},"next":{"title":"Fetching data from CO-OPS ERDDAP with Python tools","url":"/2016-10-12-fetching-data","group":"Code Gallery"}}},"domain":"http://localhost:3001"}