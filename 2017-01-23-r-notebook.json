art":{"line":14,"column":1},"end":{"line":14,"column":1}},"key":"LPcAgVOX1t"},{"type":"link","url":"https://dankelley.github.io/oce/","position":{"start":{"line":14,"column":1},"end":{"line":14,"column":1}},"children":[{"type":"inlineCode","value":"r-oce","position":{"start":{"line":14,"column":1},"end":{"line":14,"column":1}},"key":"tktw8xNMY2"}],"urlSource":"https://dankelley.github.io/oce/","key":"YxczYD2qgR"},{"type":"text","value":".","position":{"start":{"line":14,"column":1},"end":{"line":14,"column":1}},"key":"spwTn8wqh8"}],"key":"j3fyFCtpti"},{"type":"paragraph","position":{"start":{"line":16,"column":1},"end":{"line":16,"column":1}},"children":[{"type":"text","value":"(The original post for the examples below can be found author’s blog: ","position":{"start":{"line":16,"column":1},"end":{"line":16,"column":1}},"key":"ln5S8kyHCV"},{"type":"link","url":"https://dankelley.github.io/blog/","position":{"start":{"line":16,"column":1},"end":{"line":16,"column":1}},"children":[{"type":"text","value":"https://​dankelley​.github​.io​/blog/","position":{"start":{"line":16,"column":1},"end":{"line":16,"column":1}},"key":"sQxyxMzb6A"}],"urlSource":"https://dankelley.github.io/blog/","key":"JY21eJFohs"},{"type":"text","value":")","position":{"start":{"line":16,"column":1},"end":{"line":16,"column":1}},"key":"mfQe4s1E92"}],"key":"LmqTQuQM3A"}],"key":"b3NFLzOxHH"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"r","executable":true,"value":"library(gsw)\nlibrary(oce)","key":"doDnMgoaFt"},{"type":"outputs","id":"1dJAtaoxKvLxGn-FrAUD6","children":[],"key":"yf3yseJ2hT"}],"key":"LK70YOfaTo"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Example 1: calculating the day length.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"e0IeRNPXeq"}],"key":"x10mCT6taq"}],"key":"NsDL13mAw5"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"r","executable":true,"value":"daylength <- function(t, lon=-38.5, lat=-13)\n{\n    t <- as.numeric(t)\n    alt <- function(t)\n        sunAngle(t, longitude=lon, latitude=lat)$altitude\n    rise <- uniroot(alt, lower=t-86400/2, upper=t)$root\n    set <- uniroot(alt, lower=t, upper=t+86400/2)$root\n    set - rise\n}\n\nt0 <- as.POSIXct(\"2017-01-01 12:00:00\", tz=\"UTC\")\nt <- seq.POSIXt(t0, by=\"1 day\", length.out=1*356)\ndayLength <- unlist(lapply(t, daylength))\n\npar(mfrow=c(2,1), mar=c(3, 3, 1, 1), mgp=c(2, 0.7, 0))\n\nplot(t, dayLength/3600, type='o', pch=20,\n     xlab=\"\", ylab=\"Day length (hours)\")\ngrid()\nsolstice <- as.POSIXct(\"2013-12-21\", tz=\"UTC\")\n\nplot(t[-1], diff(dayLength), type='o', pch=20,\n     xlab=\"Day in 2017\", ylab=\"Seconds gained per day\")\ngrid()","key":"HyjYO0XU4g"},{"type":"outputs","id":"nylvE9BnyEyrcb4_S9AaF","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"76acad6d3b5f048fea3c76f4b7bb4500","path":"/ioos_code_lab/build/76acad6d3b5f048fea3c76f4b7bb4500.png"},"text/plain":{"content":"plot without title","content_type":"text/plain"}}},"children":[],"key":"iwgBa6uLen"}],"key":"Ae3Z9uDOVq"}],"key":"ep8xcQke1W"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Example 2: least-square fit.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"NvKYimFLks"}],"key":"FenFCTXFgy"}],"key":"DF87C6a4Yp"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"r","executable":true,"value":"x <- 1:100\ny <- 1 + x/100 + sin(x/5)\nyn <- y + rnorm(100, sd=0.1)\nL <- 4\ncalc <- runlm(x, y, L=L, deriv=0)\nplot(x, y, type='l', lwd=7, col='gray')\npoints(x, yn, pch=20, col='blue')\nlines(x, calc, lwd=2, col='red')","key":"TU04mFtgkQ"},{"type":"outputs","id":"d7Rg4D3YC6i7a-KdrMJ-K","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"3b9716be80e8e002e2c8cd9dc9308956","path":"/ioos_code_lab/build/3b9716be80e8e002e2c8cd9dc9308956.png"},"text/plain":{"content":"plot without title","content_type":"text/plain"}}},"children":[],"key":"sbpTU5eldv"}],"key":"UqqAYGh32c"}],"key":"vWSzUdfE9v"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"r","executable":true,"value":"data(ctd)\nrho <- swRho(ctd)\nz <- swZ(ctd)\ndrhodz <- runlm(z, rho, deriv = 1)\ng <- 9.81\nrho0 <- mean(rho, na.rm = TRUE)\nN2 <- -g * drhodz/rho0\nplot(ctd, which = \"N2\")\nlines(N2, -z, col = \"blue\")\nlegend(\"bottomright\", lwd = 2, col = c(\"brown\", \"blue\"), legend = c(\"spline\", \n    \"runlm\"), bg = \"white\")","key":"QNHQEqGd3Q"},{"type":"outputs","id":"MoJY9DngcLdcEwbT6kJHh","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"2acc0a5ea1cab6a4888fd74a8cdf36d3","path":"/ioos_code_lab/build/2acc0a5ea1cab6a4888fd74a8cdf36d3.png"},"text/plain":{"content":"plot without title","content_type":"text/plain"}}},"children":[],"key":"Z7suoEjqA1"}],"key":"r02kl2Dzyk"}],"key":"cXuxuXLzAh"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Example 3: T-S diagram.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"Uc7191UYyY"}],"key":"EcTNgBJRCi"}],"key":"m5mPk9SOnF"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"r","executable":true,"value":"# Alter next three lines as desired; a and b are watermasses.\nSa <- 30\nTa <- 10\nSb <- 40\n\nlibrary(oce)\n# Should not need to edit below this line\nrho0 <- swRho(Sa, Ta, 0)\nTb <- uniroot(function(T) rho0-swRho(Sb,T,0), lower=0, upper=100)$root\nSc <- (Sa + Sb) /2\nTc <- (Ta + Tb) /2\n## density change, and equiv temp change\ndrho <- swRho(Sc, Tc, 0) - rho0\ndT <- drho / rho0 / swAlpha(Sc, Tc, 0)\n\nplotTS(as.ctd(c(Sa, Sb, Sc), c(Ta, Tb, Tc), 0), pch=20, cex=2)\ndrawIsopycnals(levels=rho0, col=\"red\", cex=0)\nsegments(Sa, Ta, Sb, Tb, col=\"blue\")\ntext(Sb, Tb, \"b\", pos=4)\ntext(Sa, Ta, \"a\", pos=4)\ntext(Sc, Tc, \"c\", pos=4)\nlegend(\"topleft\",\n       legend=sprintf(\"Sa=%.1f, Ta=%.1f, Sb=%.1f  ->  Tb=%.1f, drho=%.2f, dT=%.2f\",\n                      Sa, Ta, Sb, Tb, drho, dT),\n       bg=\"white\")","key":"fv0AWBZ8rE"},{"type":"outputs","id":"ALhl6x12H8ryTJp9heExk","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"4d9ab1486e7cae05a8f19db7705383a2","path":"/ioos_code_lab/build/4d9ab1486e7cae05a8f19db7705383a2.png"},"text/plain":{"content":"plot without title","content_type":"text/plain"}}},"children":[],"key":"dVlScEcYPQ"}],"key":"LQ53yDR4Iq"}],"key":"kLNNjTgSas"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Example 4: find the halocline depth.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"GclfofUSUm"}],"key":"Q7UxmpYdaK"}],"key":"bd9kziHip5"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"r","executable":true,"value":"findHalocline <- function(ctd, deltap=5, plot=TRUE)\n{\n    S <- ctd[['salinity']]\n    p <- ctd[['pressure']]\n    n <- length(p)\n    ## trim df to be no larger than n/2 and no smaller than 3.\n    N <- deltap / median(diff(p))\n    df <- min(n/2, max(3, n / N))\n    spline <- smooth.spline(S~p, df=df)\n    SS <- predict(spline, p)\n    dSSdp <- predict(spline, p, deriv=1)\n    H <- p[which.max(dSSdp$y)]\n    if (plot) {\n        par(mar=c(3, 3, 1, 1), mgp=c(2, 0.7, 0))\n        plotProfile(ctd, xtype=\"salinity\")\n        lines(SS$y, SS$x, col='red')\n        abline(h=H, col='blue')\n        mtext(sprintf(\"%.2f m\", H), side=4, at=H, cex=3/4, col='blue')\n        mtext(sprintf(\" deltap: %.0f, N: %.0f, df: %.0f\", deltap, N, df),\n              side=1, line=-1, adj=0, cex=3/4)\n    }\n    return(H)\n}\n  \n# Plot two panels to see influence of deltap.\npar(mfrow=c(1, 2))\ndata(ctd)\nfindHalocline(ctd)\nfindHalocline(ctd, 1)","key":"jnRftVUTyP"},{"type":"outputs","id":"of9HJD_vKdcEHlxuYShkV","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"text/html":{"content":"4.292","content_type":"text/html"},"text/latex":{"content":"4.292","content_type":"text/latex"},"text/markdown":{"content":"4.292","content_type":"text/markdown"},"text/plain":{"content":"[1] 4.292","content_type":"text/plain"}}},"children":[],"key":"VPyfTJVtRT"},{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"text/html":{"content":"4.721","content_type":"text/html"},"text/latex":{"content":"4.721","content_type":"text/latex"},"text/markdown":{"content":"4.721","content_type":"text/markdown"},"text/plain":{"content":"[1] 4.721","content_type":"text/plain"}}},"children":[],"key":"iXsVQCr7S5"},{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"2abe9d968db3cb244229dfe6973107f8","path":"/ioos_code_lab/build/2abe9d968db3cb244229dfe6973107f8.png"},"text/plain":{"content":"plot without title","content_type":"text/plain"}}},"children":[],"key":"zWzqH0GuwT"}],"key":"i6msAwHCVJ"}],"key":"KhXO3vP40o"}],"key":"XjZx0zAKrF"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Parsing Conventions and standards with Python","url":"/2016-11-16-cf-ugrid-sgrid-conventions","group":"Code Gallery"},"next":{"title":"A Matlab notebook primer","url":"/2017-03-30-octave-notebo