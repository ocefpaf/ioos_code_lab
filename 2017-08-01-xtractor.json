":1,"column":1},"end":{"line":1,"column":1}},"key":"Luic1jo4QU"},{"type":"inlineCode","value":"maps","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"Ye7xdBURhT"},{"type":"text","value":" and ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"fuQUb9XOCL"},{"type":"inlineCode","value":"ggplot2","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"Np8B1YO6Zq"},{"type":"text","value":" packages to plot the results.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"pZyh5NTAfU"}],"key":"V8yhqYNmyP"}],"key":"sDxIvfjW7y"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"r","executable":true,"value":"library('ggplot2')\nlibrary('maps')\nlibrary('mapdata')\n\nalldata <- cbind(swchl, tagData)\nalldata$lon <- alldata$lon - 360\nalldata$missing <- is.na(alldata$mean) * 1\ncolnames(alldata)[1] <- 'mean'\n\n# set limits of the map\nylim <- c(15, 30)\nxlim <- c(-160, -105)\n\n# get outline data for map\nw <- map_data(\"worldHires\", ylim = ylim, xlim = xlim)\n\n# plot using ggplot\nmyColor <- colors$algae\nz <- ggplot(alldata,aes(x = lon, y = lat)) + \n   geom_point(aes(colour = mean, shape = factor(missing)), size = 2.) + \n   scale_shape_manual(values = c(19, 1))\nz + geom_polygon(data = w, aes(x = long, y = lat, group = group), fill = \"grey80\") + \n  theme_bw() + \n  scale_colour_gradientn(colours = myColor, limits = c(0., 0.32), \"Chla\") + \n  coord_fixed(1.3, xlim = xlim, ylim = ylim) + ggtitle(\"Mean chla values at marlin tag locations\")","key":"zUyzFOsoNJ"},{"type":"outputs","id":"g9zscms1PLmDi0yIA4nWE","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{"image/png":{"height":420,"width":420}},"data":{"image/png":{"content_type":"image/png","hash":"8eba96031b0c703d59bdd84ef4dc4eea","path":"/ioos_code_lab/build/8eba96031b0c703d59bdd84ef4dc4eea.png"},"text/plain":{"content":"plot without title","content_