     CF Roles:   timeseries_id: ['station']\n\nCoordinates:\n             CF Axes:   X: ['longitude']\n                        Y: ['latitude']\n                        T: ['time']\n                        Z: n/a\n\n      CF Coordinates:   longitude: ['longitude']\n                        latitude: ['latitude']\n                        time: ['time']\n                        vertical: n/a\n\n       Cell Measures:   area, volume: n/a\n\n      Standard Names:   latitude: ['latitude']\n                        longitude: ['longitude']\n                        time: ['time']\n\n              Bounds:   n/a\n\n       Grid Mappings:   n/a\n\nData Variables:\n       Cell Measures:   area, volume: n/a\n\n      Standard Names:   aggregate_quality_flag: ['sea_surface_height_above_sea_level_geoid_mhhw_qc_agg']\n                        altitude: ['z']\n                        sea_surface_height_above_sea_level: ['sea_surface_height_above_sea_level_geoid_mhhw']\n                        sea_surface_height_above_sea_level quality_flag: ['sea_surface_height_above_sea_level_geoid_mhhw_qc_tests']\n\n              Bounds:   n/a\n\n       Grid Mappings:   n/a","content_type":"text/plain"}}},"children":[],"key":"dxavt82PgC"}],"key":"Im27DZPnzp"}],"key":"VRvrjRNpIW"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"from ioos_qc.config import QcConfig\n\nqc = QcConfig(qc_config)\n\n# The result is always a list but we only want the first, one and only in this case, variable.\nvariable_name = data.cf.standard_names[\"sea_surface_height_above_sea_level\"][0]\n\nqc_results = qc.run(\n    inp=data[variable_name],\n    tinp=data.cf[\"T\"].to_numpy(),\n)\n\nqc_results","key":"EF04fpsSkw"},{"type":"outputs","id":"QtLbaWckBk9OdAyMj_tEU","children":[{"type":"output","jupyter_data":{"output_type":"execute_result","execution_count":3,"metadata":{},"data":{"text/plain":{"content":"defaultdict(collections.OrderedDict,\n            {'qartod': OrderedDict([('gross_range_test',\n                           array([1, 1, 1, ..., 1, 1, 1], dtype=uint8)),\n                          ('flat_line_test',\n                           array([1, 1, 1, ..., 1, 1, 1], dtype=uint8)),\n                          ('spike_test',\n                           array([2, 1, 1, ..., 1, 1, 2], dtype=uint8))])})","content_type":"text/plain"}}},"children":[],"key":"uAoTo4W1Uw"}],"key":"RIPctqwu5B"}],"key":"Sbxs6NuWtW"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The results are returned in a dictionary format, similar to the input configuration, with a mask for each test. While the mask ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"CEaqjFZzSn"},{"type":"strong","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"is","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"yufyFWyac2"}],"key":"AGSDFrl7xc"},{"type":"text","value":" a masked array it should not be applied as such. The results range from 1 to 4 meaning:","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"VLa5MC1OtX"}],"key":"KsKHlnYGMf"},{"type":"list","ordered":true,"start":1,"spread":false,"position":{"start":{"line":3,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"data passed the QA/QC","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"Exrf3u0DHg"}],"key":"yKq78ZExry"}],"key":"LpPYawRsyx"},{"type":"listItem","spread":true,"position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"did not run on this data point","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"KgYXq83wQe"}],"key":"RsJrWJpHnD"}],"key":"Gn1tOuZBhS"},{"type":"listItem","spread":true,"position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"flag as suspect","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"RuN0Ze7LUM"}],"key":"RQa0dP9Fw5"}],"key":"Z4Wy9jwhwm"},{"type":"listItem","spread":true,"position":{"start":{"line":6,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"flag as failed","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"tzWdOrVdhf"}],"key":"oN3DYYMZcd"}],"key":"eo9M6ZTg17"}],"key":"d71IilQZQC"},{"type":"paragraph","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"children":[{"type":"text","value":"Now we can write a plotting function that will read these results and flag the data.","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"key":"Tba2zzCBig"}],"key":"l00ixaupfE"}],"key":"PSS1AStgoY"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import matplotlib.pyplot as plt\nimport numpy as np\n\n\ndef plot_results(data, variable_name, results, title, test_name):\n    time = data.cf[\"time\"]\n    obs = data[variable_name]\n    qc_test = results[\"qartod\"][test_name]\n\n    qc_pass = np.ma.masked_where(qc_test != 1, obs)\n    qc_suspect = np.ma.masked_where(qc_test != 3, obs)\n    qc_fail = np.ma.masked_where(qc_test != 4, obs)\n    qc_notrun = np.ma.masked_where(qc_test != 2, obs)\n\n    fig, ax = plt.subplots(figsize=(15, 3.75))\n    fig.set_title = f\"{test_name}: {title}\"\n\n    ax.set_xlabel(\"Time\")\n    ax.set_ylabel(\"Observation Value\")\n\n    kw = {\"marker\": \"o\", \"linestyle\": \"none\"}\n    ax.plot(time, obs, label=\"obs\", color=\"#A6CEE3\")\n    ax.plot(\n        time, qc_notrun, markersize=2, label=\"qc not run\", color=\"gray\", alpha=0.2, **kw\n    )\n    ax.plot(\n        time, qc_pass, markersize=4, label=\"qc pass\", color=\"green\", alpha=0.5, **kw\n    )\n    ax.plot(\n        time,\n        qc_suspect,\n        markersize=4,\n        label=\"qc suspect\",\n        color=\"orange\",\n        alpha=0.7,\n        **kw,\n    )\n    ax.plot(time, qc_fail, markersize=6, label=\"qc fail\", color=\"red\", alpha=1.0, **kw)\n    ax.grid(True)\n\n\ntitle = \"Water Level [MHHW] [m] : Kotzebue, AK\"","key":"UDu8rt2piU"},{"type":"outputs","id":"KGefeRJ0pVQEpV-0SWM22","children":[],"key":"DK13z1BC0M"}],"key":"Rh8ZMX4MpP"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The gross range test test should fail data outside the ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"MklnJXmMbM"},{"type":"inlineMath","value":"\\\\pm","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"html":"<span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mspace linebreak=\"newline\"></mspace><mi>p</mi><mi>m</mi></mrow><annotation encoding=\"application/x-tex\">\\\\pm</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"mspace newline\"></span><span class=\"base\"><span class=\"strut\" style=\"height:0.625em;vertical-align:-0.1944em;\"></span><span class=\"mord mathnormal\">p</span><span class=\"mord mathnormal\">m</span></span></span></span>","key":"s5UXtOR2TY"},{"type":"text","value":" 10 range and suspect data below -2, and greater than 3. As one can easily see all the major spikes are flagged as expected.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"TU4kqUpA8O"}],"key":"Umk218K11b"}],"key":"qsDVMqsPSf"},{"type":"block","kind":"