e most of the biomass was found around the ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"la4mAUlZCa"},{"type":"inlineCode","value":"Dendrogyra","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"IVlkZkWJIT"},{"type":"text","value":" genus in Patch Reef habitats.\nBut where are those Coral Reefs? How is the distribution of top three species with more biomass around them?\nWith a ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"nv9OOCyKbv"},{"type":"inlineCode","value":"pandas","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"YwaUO8MBAT"},{"type":"text","value":" ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"QpKHoSzYih"},{"type":"inlineCode","value":"DataFrame","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"jGT6it5nYy"},{"type":"text","value":" it is easy to group the data by location and count the ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"QsXfXq7AxX"},{"type":"inlineCode","value":"genus","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"HqAqxHcyxo"},{"type":"text","value":" occurrence based on it.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"xTR6ib29vh"}],"key":"ZVm6XXPvge"}],"key":"LmtcNp5y1F"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import cartopy.crs as ccrs\nimport cartopy.feature as cfeature\nimport matplotlib.pyplot as plt\nimport numpy as np\nfrom cartopy.mpl.ticker import LatitudeFormatter, LongitudeFormatter\n\n\ndef make_plot():\n    bbox = [-82, -80, 24, 26]\n    projection = ccrs.PlateCarree()\n\n    fig, ax = plt.subplots(figsize=(9, 9), subplot_kw=dict(projection=projection))\n\n    ax.set_extent(bbox)\n\n    land = cfeature.NaturalEarthFeature(\n        \"physical\", \"land\", \"10m\", edgecolor=\"face\", facecolor=[0.85] * 3\n    )\n\n    ax.add_feature(land, zorder=0)\n    ax.coastlines(\"10m\", zorder=1)\n\n    ax.set_xticks(np.linspace(bbox[0], bbox[1], 3), crs=projection)\n    ax.set_yticks(np.linspace(bbox[2], bbox[3], 3), crs=projection)\n    lon_formatter = LongitudeFormatter(zero_direction_label=True)\n    lat_formatter = LatitudeFormatter()\n    ax.xaxis.set_major_formatter(lon_formatter)\n    ax.yaxis.set_major_formatter(lat_formatter)\n    return fig, ax","key":"i9875tGMRo"},{"type":"outputs","id":"0hl4-yzDvFv1ByIsR0caY","children":[],"key":"kCkMEPFyze"}],"key":"l5ijozJ1WF"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"count = (\n    cremp_1996.loc[cremp_1996[\"genus\"] == \"Acropora\"]\n    .groupby([\"longitude\", \"latitude\"])\n    .count()\n    .reset_index()\n)\n\n\nfig, ax = make_plot()\nc = ax.scatter(\n    count[\"longitude\"],\n    count[\"latitude\"],\n    s=200,\n    c=count[\"genus\"],\n    alpha=0.5,\n    cmap=plt.cm.get_cmap(\"viridis_r\", 6),\n    zorder=3,\n)\ncbar = fig.colorbar(c, shrink=0.75, extend=\"both\")\ncbar.ax.set_ylabel(\"Genus occurrence count\")\nax.set_title(\"Acropora\");","key":"Vh1XRDMkNS"},{"type":"outputs","id":"7R9twYaZ3lUprRh2z2Nae","children":[{"type":"output","jupyter_data":{"name":"stderr","output_type":"stream","text":"/tmp/ipykernel_9861/710676339.py:16: MatplotlibDeprecationWarning: The get_cmap function was deprecated in Matplotlib 3.7 and will be removed two minor releases later. Use ``matplotlib.colormaps[name]`` or ``matplotlib.colormaps.get_cmap(obj)`` instead.\n  cmap=plt.cm.get_cmap(\"viridis_r\", 6),\n"},"children":[],"key":"U5SOyel7Xm"},{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"4ecb2f15f004be1942328abdfea2b4f5","path":"/ioos_code_lab/build/4ecb2f15f004be1942328abdfea2b4f5.png"},"text/plain":{"content":"<Figure size 900x900 with 2 Axes>","content_typ