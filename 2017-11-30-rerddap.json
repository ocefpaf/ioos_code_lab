 ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"M5ORdqAzip"},{"type":"inlineCode","value":"Dendrogyra","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"r3Zp8hbzO4"},{"type":"text","value":" genus in Patch Reef habitats.\nBut where are those Coral Reefs? How is the distribution of top three species with more biomass around them?\nWith a ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"KnbEWxMRQC"},{"type":"inlineCode","value":"pandas","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"alDyNC1dm6"},{"type":"text","value":" ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"kF7SqkrJUK"},{"type":"inlineCode","value":"DataFrame","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"kdnj0TLB1z"},{"type":"text","value":" it is easy to group the data by location and count the ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"EZXXfHKVut"},{"type":"inlineCode","value":"genus","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"PskSzkRkJy"},{"type":"text","value":" occurrence based on it.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"dvaBi4cME7"}],"key":"xhTzdI6gYu"}],"key":"GtJPy6ACkC"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import cartopy.crs as ccrs\nimport cartopy.feature as cfeature\nimport matplotlib.pyplot as plt\nimport numpy as np\nfrom cartopy.mpl.ticker import LatitudeFormatter, LongitudeFormatter\n\n\ndef make_plot():\n    bbox = [-82, -80, 24, 26]\n    projection = ccrs.PlateCarree()\n\n    fig, ax = plt.subplots(figsize=(9, 9), subplot_kw=dict(projection=projection))\n\n    ax.set_extent(bbox)\n\n    land = cfeature.NaturalEarthFeature(\n        \"physical\", \"land\", \"10m\", edgecolor=\"face\", facecolor=[0.85] * 3\n    )\n\n    ax.add_feature(land, zorder=0)\n    ax.coastlines(\"10m\", zorder=1)\n\n    ax.set_xticks(np.linspace(bbox[0], bbox[1], 3), crs=projection)\n    ax.set_yticks(np.linspace(bbox[2], bbox[3], 3), crs=projection)\n    lon_formatter = LongitudeFormatter(zero_direction_label=True)\n    lat_formatter = LatitudeFormatter()\n    ax.xaxis.set_major_formatter(lon_formatter)\n    ax.yaxis.set_major_formatter(lat_formatter)\n    return fig, ax","key":"szi07ImKM6"},{"type":"outputs","id":"EUuE6mOkQYxqCB6e-bywf","children":[],"key":"OHxSVD7WUY"}],"key":"Qa7b2NdYtf"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"count = (\n    cremp_1996.loc[cremp_1996[\"genus\"] == \"Acropora\"]\n    .groupby([\"longitude\", \"latitude\"])\n    .count()\n    .reset_index()\n)\n\n\nfig, ax = make_plot()\nc = ax.scatter(\n    count[\"longitude\"],\n    count[\"latitude\"],\n    s=200,\n    c=count[\"genus\"],\n    alpha=0.5,\n    cmap=plt.cm.get_cmap(\"viridis_r\", 6),\n    zorder=3,\n)\ncbar = fig.colorbar(c, shrink=0.75, extend=\"both\")\ncbar.ax.set_ylabel(\"Genus occurrence count\")\nax.set_title(\"Acropora\");","key":"eGu393TCbl"},{"type":"outputs","id":"ZAdEHd9sKyLEIYHOFt6AL","children":[{"type":"output","jupyter_data":{"name":"stderr","output_type":"stream","text":"/tmp/ipykernel_9861/710676339.py:16: MatplotlibDeprecationWarning: The get_cmap function was deprecated in Matplotlib 3.7 and will be removed two minor releases later. Use ``matplotlib.colormaps[name]`` or ``matplotlib.colormaps.get_cmap(obj)`` instead.\n  cmap=plt.cm.get_cmap(\"viridis_r\", 6),\n"},"children":[],"key":"iI9oJN735b"},{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"4ecb2f15f004be1942328abdfea2b4f5","path":"/build/4ecb2f15f004be1942328abdfea2b4f5.png"},"text/plain":{"content":"<Figure size 900x900 with 2 Axes>","content_type":"text/plain"}}},"children":[],"key":"mTfmLLV3P5"}],"k